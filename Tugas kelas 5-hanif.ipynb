    "nilai_mahasiswa = {\n",
    "    \"Andi\": (80, 85, 90),\n",
    "    \"Budi\": (75, 70, 80),\n",
    "    \"Citra\": (85, 90, 95)\n",
    "}\n",
    "\n",
    "for nama, nilai in nilai_mahasiswa.items():\n",
    "    rata_rata = sum(nilai) / len(nilai)\n",
    "    print(f\"{nama}: {rata_rata}\")"
   ]
